<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using Material 3 DayNight -->
    <style name="Theme.WakeMeThere" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Theme for Lockscreen Override Active Alarm Activity -->
    <style name="Theme.WakeMeThere.Alarm" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>

